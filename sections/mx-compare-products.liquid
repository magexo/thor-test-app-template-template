<div class="mx-compare page-width">
  <h1 class="mx-compare__title">{{ 'content.compare.page_title' | t }}</h1>

  <div class="mx-compare__loading" id="mx-compare-loading" hidden>
    {{ 'content.compare.loading' | t }}
  </div>

  <div class="mx-compare__empty" id="mx-compare-empty" hidden>
    <p class="mx-compare__empty-title">{{ 'content.compare.empty_title' | t }}</p>
    <p class="mx-compare__empty-message">{{ 'content.compare.empty_message' | t }}</p>
    <a href="{{ routes.collections_url }}" class="mx-compare__empty-link">
      {{ 'content.compare.browse_catalog' | t }}
    </a>
  </div>

  <div class="mx-compare__table-wrapper" id="mx-compare-table-wrapper" hidden>
    <table class="mx-compare__table" id="mx-compare-table">
      <thead>
        <tr id="mx-compare-header-row"></tr>
      </thead>
      <tbody id="mx-compare-body"></tbody>
    </table>
  </div>

  <div class="mx-compare__cards" id="mx-compare-cards" hidden></div>
</div>

<script type="module">
  import { MxCompare } from '{{ 'mx-compare.js' | asset_url }}';

  const ATTR_ROWS = [
    { key: 'image', label: {{ 'content.compare.image' | t | json }} },
    { key: 'title', label: {{ 'content.compare.title' | t | json }} },
    { key: 'price', label: {{ 'content.compare.price' | t | json }} },
    { key: 'vendor', label: {{ 'content.compare.vendor' | t | json }} },
    { key: 'availability', label: {{ 'content.compare.availability' | t | json }} },
    { key: 'description', label: {{ 'content.compare.description' | t | json }} },
  ];

  const T = {
    remove: {{ 'content.compare.remove' | t | json }},
    available: {{ 'content.compare.available' | t | json }},
    unavailable: {{ 'content.compare.unavailable' | t | json }},
  };

  const designMode = window.Shopify?.designMode;

  async function fetchProduct(handle) {
    const res = await fetch(`/products/${handle}.js`);
    if (!res.ok) return null;
    return res.json();
  }

  function formatMoney(cents) {
    return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: window.Shopify?.currency?.active || 'USD' });
  }

  function buildHeaderCell(product) {
    const th = document.createElement('th');
    th.className = 'mx-compare__product-header';
    const removeBtn = document.createElement('button');
    removeBtn.className = 'mx-compare__product-remove';
    removeBtn.setAttribute('aria-label', T.remove);
    removeBtn.textContent = '×';
    removeBtn.addEventListener('click', () => {
      MxCompare.removeProduct(product.handle);
      renderPage();
    });
    th.appendChild(removeBtn);

    if (product.featured_image) {
      const img = document.createElement('img');
      img.src = product.featured_image;
      img.alt = product.title;
      img.className = 'mx-compare__product-image';
      img.loading = 'lazy';
      th.appendChild(img);
    }

    const titleLink = document.createElement('a');
    titleLink.href = product.url;
    titleLink.className = 'mx-compare__product-title';
    titleLink.textContent = product.title;
    th.appendChild(titleLink);

    return th;
  }

  function getCellContent(product, key) {
    switch (key) {
      case 'image': return '';
      case 'title': return `<a href="${product.url}" class="mx-compare__product-title">${product.title}</a>`;
      case 'price': return `<span class="mx-compare__price">${formatMoney(product.price)}</span>`;
      case 'vendor': return product.vendor || '—';
      case 'availability': {
        const available = product.available;
        return `<span class="mx-compare__availability mx-compare__availability--${available ? 'available' : 'unavailable'}">${available ? T.available : T.unavailable}</span>`;
      }
      case 'description': return `<div class="mx-compare__description">${product.description || '—'}</div>`;
      default: return '—';
    }
  }

  function buildCardRemoveBtn(handle) {
    const btn = document.createElement('button');
    btn.className = 'mx-compare__card-remove';
    btn.setAttribute('aria-label', T.remove);
    btn.textContent = '×';
    btn.addEventListener('click', () => {
      MxCompare.removeProduct(handle);
      renderPage();
    });
    return btn;
  }

  function buildCard(product) {
    const card = document.createElement('div');
    card.className = 'mx-compare__card';

    const header = document.createElement('div');
    header.className = 'mx-compare__card-header';
    header.appendChild(buildCardRemoveBtn(product.handle));

    if (product.featured_image) {
      const img = document.createElement('img');
      img.src = product.featured_image;
      img.alt = product.title;
      img.className = 'mx-compare__product-image';
      img.loading = 'lazy';
      header.appendChild(img);
    }

    const titleLink = document.createElement('a');
    titleLink.href = product.url;
    titleLink.className = 'mx-compare__product-title';
    titleLink.textContent = product.title;
    header.appendChild(titleLink);
    card.appendChild(header);

    const body = document.createElement('div');
    body.className = 'mx-compare__card-body';

    const rowKeys = ['price', 'vendor', 'availability', 'description'];
    for (const row of ATTR_ROWS) {
      if (!rowKeys.includes(row.key)) continue;
      const rowEl = document.createElement('div');
      rowEl.className = 'mx-compare__card-row';
      rowEl.innerHTML = `<span class="mx-compare__card-label">${row.label}</span><span class="mx-compare__card-value">${getCellContent(product, row.key)}</span>`;
      body.appendChild(rowEl);
    }
    card.appendChild(body);
    return card;
  }

  async function renderPage() {
    const loadingEl = document.getElementById('mx-compare-loading');
    const emptyEl = document.getElementById('mx-compare-empty');
    const tableWrapper = document.getElementById('mx-compare-table-wrapper');
    const headerRow = document.getElementById('mx-compare-header-row');
    const tbody = document.getElementById('mx-compare-body');
    const cardsEl = document.getElementById('mx-compare-cards');

    let handles = MxCompare.getProducts();

    if (designMode && handles.length === 0) {
      handles = ['__preview__'];
    }

    if (handles.length === 0) {
      loadingEl.hidden = true;
      emptyEl.hidden = false;
      tableWrapper.hidden = true;
      cardsEl.hidden = true;
      return;
    }

    loadingEl.hidden = false;
    emptyEl.hidden = true;
    tableWrapper.hidden = true;
    cardsEl.hidden = true;

    const products = await Promise.all(handles.map((h) => h === '__preview__' ? null : fetchProduct(h)));
    const validProducts = products.filter(Boolean);

    loadingEl.hidden = true;

    if (validProducts.length === 0) {
      emptyEl.hidden = false;
      return;
    }

    // Build desktop table
    headerRow.innerHTML = '<th></th>';
    validProducts.forEach((p) => headerRow.appendChild(buildHeaderCell(p)));

    tbody.innerHTML = '';
    for (const row of ATTR_ROWS) {
      if (row.key === 'image') continue;
      const tr = document.createElement('tr');
      const th = document.createElement('th');
      th.textContent = row.label;
      tr.appendChild(th);
      validProducts.forEach((p) => {
        const td = document.createElement('td');
        td.innerHTML = getCellContent(p, row.key);
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    }
    tableWrapper.hidden = false;

    // Build mobile cards
    cardsEl.innerHTML = '';
    validProducts.forEach((p) => cardsEl.appendChild(buildCard(p)));
    cardsEl.hidden = false;
  }

  renderPage();
  document.addEventListener('mx:compare:update', renderPage);
</script>

{% schema %}
{
  "name": "t:names.compare_products",
  "settings": [],
  "presets": [
    {
      "name": "t:names.compare_products"
    }
  ]
}
{% endschema %}
